{
  "name": "@oomol-lab/open-connector",
  "version": "1.3.4",
  "private": true,
  "workspaces": [
    "web"
  ],
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/ensure-generated.ts",
    "dev": "node --watch src/saas/index.ts",
    "build": "npm run generate:catalog && npm run typecheck && npm run build:web",
    "build:web": "npm run build --workspace web",
    "start": "node src/saas/index.ts",
    "test": "vitest run",
    "test:rls": "RLS_TEST_GATE=1 vitest run src/saas/storage/scoped-query.test.ts src/saas/storage/postgres-runtime-database.test.ts src/saas/oauth/postgres-refresh-coordinator.test.ts",
    "typecheck": "node scripts/typecheck.ts src scripts-all",
    "generate:registry": "node scripts/generate-provider-registry.ts",
    "generate:catalog": "node scripts/generate-catalog.ts",
    "generate:provider": "node scripts/generate-provider.ts",
    "migrate": "node scripts/saas-migrate.ts",
    "backfill-connections": "node scripts/saas-backfill-connections.ts",
    "upstream:check": "node scripts/check-upstream-base.ts",
    "upstream:review": "node scripts/upstream-review.ts",
    "upstream:protected": "node scripts/check-protected-upstream.ts",
    "verify:no-legacy-runtime": "node scripts/verify-no-legacy-runtime.ts",
    "verify:generated": "npm run generate:catalog && git diff --exit-code -- src/providers/registry.generated.ts catalog/apps",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "fix": "npm run lint:fix && npm run format:fix",
    "fix-check": "npm run fix && npm run typecheck"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1102.0",
    "@cfworker/json-schema": "^4.1.1",
    "@hono/node-server": "^2.0.10",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ali-oss": "^6.23.0",
    "fast-xml-parser": "^5.10.1",
    "hono": "^4.12.27",
    "imapflow": "^1.4.6",
    "jose": "^6.2.3",
    "mailparser": "^3.9.14",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.1.2",
    "micromark-extension-gfm": "^3.0.0",
    "minisearch": "^7.2.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "rss-parser": "^3.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hyrious/configs": "^0.1.6",
    "@types/ali-oss": "^6.23.3",
    "@types/mailparser": "^3.4.6",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.0.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.3",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true
  }
}
