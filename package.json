{
  "name": "@oomol-lab/open-connector",
  "version": "0.0.0-development",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.txt",
  "workspaces": [
    "web"
  ],
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/ensure-generated.ts",
    "dev": "node --experimental-transform-types --watch src/saas/index.ts",
    "build": "npm run generate:catalog && npm run typecheck && npm run build:web",
    "build:web": "npm run build --workspace web",
    "start": "node --experimental-transform-types src/saas/index.ts",
    "test": "vitest run",
    "test:rls": "RLS_TEST_GATE=1 vitest run src/saas/storage/scoped-query.test.ts src/saas/storage/postgres-runtime-database.test.ts src/saas/oauth/postgres-refresh-coordinator.test.ts src/saas/storage/postgres-action-policy-store.test.ts src/saas/storage/postgres-connection-store.test.ts src/saas/storage/postgres-connection-request-store.test.ts src/saas/storage/scoped-processing.test.ts src/saas/triggers/postgres-trigger-store.test.ts src/saas/triggers/shared-trigger-lifecycle.test.ts src/saas/lifecycle/owned-policy-lifecycle.test.ts src/saas/saas-project-service.test.ts src/saas/saas-execution-service.test.ts src/saas/oauth/scoped-managed-oauth.test.ts src/saas/files/seaweedfs-transit-files.postgres.test.ts src/saas/server/marketplace-routes.postgres.test.ts src/saas/server/maintenance-routes.postgres.test.ts",
    "typecheck": "node scripts/typecheck.ts src scripts",
    "generate:registry": "node scripts/generate-provider-registry.ts",
    "generate:catalog": "node scripts/generate-catalog.ts",
    "migrate": "node --experimental-transform-types scripts/saas-migrate.ts",
    "backfill-connections": "node --experimental-transform-types scripts/saas-backfill-connections.ts",
    "upstream:check": "node scripts/check-upstream-base.ts",
    "upstream:review": "node scripts/upstream-review.ts",
    "upstream:protected": "node scripts/check-protected-upstream.ts",
    "verify:no-legacy-runtime": "node scripts/verify-no-legacy-runtime.ts",
    "verify:generated": "node scripts/generate-catalog.ts --check",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "fix": "npm run lint:fix && npm run format:fix",
    "fix-check": "npm run fix && npm run typecheck"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@cfworker/json-schema": "^4.1.1",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/client": "^2.3.1",
    "ali-oss": "^6.23.0",
    "busboy": "^1.6.0",
    "fast-xml-builder": "^1.3.1",
    "fast-xml-parser": "^5.11.2",
    "fast-xml-validator": "^1.4.2",
    "hono": "^4.13.13",
    "iconv-lite": "^0.7.3",
    "imapflow": "^2.4.0",
    "jose": "^6.2.12",
    "mailparser": "^3.9.38",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.2.0",
    "micromark-extension-gfm": "^3.0.0",
    "minisearch": "^7.2.0",
    "mqtt": "^5.16.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "rss-parser": "^3.13.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hyrious/configs": "^0.1.6",
    "@modelcontextprotocol/server": "^2.3.1",
    "@types/ali-oss": "^6.23.3",
    "@types/busboy": "^1.5.5",
    "@types/mailparser": "^3.9.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true
  }
}
